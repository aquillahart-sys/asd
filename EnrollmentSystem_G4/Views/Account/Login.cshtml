@model EnrollmentSystem_G4.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<section class="login-page" aria-labelledby="loginHeading">
    <a class="login-brand" asp-controller="Home" asp-action="Index">
        <span class="login-brand-mark" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
        <span><strong>Enrollment Services</strong><small>STAFF PORTAL</small></span>
    </a>

    <div class="card login-card">
        <div class="card-body">
            <p class="eyebrow login-eyebrow">CAMPUS PORTAL</p>
            <h1 id="loginHeading">Welcome back</h1>
            <p class="login-copy">Sign in with your staff account to continue.</p>
            <form asp-action="Login" method="post">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 login-submit">
                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Sign in
                </button>
            </form>
        </div>
    </div>

    <p class="login-footer">Secure access for authorized campus staff.</p>
</section>
