@model IEnumerable<EnrollmentSystem_G4.Models.AuditEntry>

@{
    ViewData["Title"] = "Audit History";
}

<div class="page-header">
    <p class="eyebrow">ADMINISTRATION</p>
    <h1 class="h2 mb-1">Audit history</h1>
    <p class="text-muted mb-0">Latest 500 login, logout, account, enrollment, payment, and data-change events.</p>
</div>

<div class="card app-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield-check me-2" aria-hidden="true"></i>Activity history</span>
        <span class="text-muted small">Passwords and password salts are never recorded.</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Date &amp; time</th><th>User</th><th>Action</th><th>Record</th><th>Details</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td class="text-nowrap">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            @entry.Username
                            @if (entry.UserId.HasValue)
                            {
                                <span class="text-muted small">(#@entry.UserId)</span>
                            }
                        </td>
                        <td><span class="badge text-bg-secondary">@entry.ActionType</span></td>
                        <td class="text-nowrap">@(entry.EntityType ?? "—") @(entry.EntityId ?? string.Empty)</td>
                        <td class="audit-details">@entry.Details</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No audit events recorded yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
