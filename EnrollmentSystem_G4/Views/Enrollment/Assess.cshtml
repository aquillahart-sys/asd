@model List<EnrollmentSystem_G4.Models.Subject>

@{
    var student = ViewBag.Student as EnrollmentSystem_G4.Models.Student;
    ViewData["Title"] = "Fee Assessment";
}

<div class="container mt-4">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Fee Assessment & Enrollment</h4>
            <span class="badge bg-light text-dark fs-6">Rate: ₱500.00 / Unit</span>
        </div>

        <div class="card-body">
            @if (student != null)
            {
                <h5>Student: <strong>@student.GetFullName()</strong> (@student.StudentNumber)</h5>
                <p class="text-muted mb-3">Email: @student.Email</p>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="Confirm" method="post">
                <input type="hidden" name="studentId" value="@student?.StudentId" />

                <h5 class="mt-4 mb-3">Available Subjects</h5>

                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-warning">
                        No subjects found in the database. Please insert sample subjects into the <code>subjects</code> table in phpMyAdmin.
                    </div>
                }
                else
                {
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">Select</th>
                                <th>Subject Code</th>
                                <th>Description</th>
                                <th class="text-center">Units</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" name="selectedSubjects" value="@sub.SubjectId" class="form-check-input subject-checkbox" data-units="@sub.Units" />
                                    </td>
                                    <td><strong>@sub.SubjectCode</strong></td>
                                    <td>@sub.SubjectDescription</td>
                                    <td class="text-center"><span class="badge bg-secondary">@sub.Units</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Calculated Total Units & Fee Summary Bar -->
                    <div class="card bg-light border mt-3 mb-4">
                        <div class="card-body d-flex justify-content-between align-items-center py-2">
                            <div>
                                <span class="fw-bold">Total Selected Units:</span>
                                <span id="selectedUnits" class="badge bg-info text-dark fs-6 ms-1">0 Units</span>
                            </div>
                            <div>
                                <span class="fw-bold">Estimated Total Assessment:</span>
                                <span id="estimatedFee" class="text-success fw-bold fs-5 ms-1">₱0.00</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-controller="Student" asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">Calculate & Process Assessment</button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const checkboxes = document.querySelectorAll(".subject-checkbox");
            const unitsDisplay = document.getElementById("selectedUnits");
            const feeDisplay = document.getElementById("estimatedFee");
            const ratePerUnit = 500.00;

            function calculateTotals() {
                let totalUnits = 0;
                checkboxes.forEach(cb => {
                    if (cb.checked) {
                        totalUnits += parseInt(cb.getAttribute("data-units")) || 0;
                    }
                });

                let totalAssessment = totalUnits * ratePerUnit;
                unitsDisplay.textContent = totalUnits + " Units";
                feeDisplay.textContent = "₱" + totalAssessment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            checkboxes.forEach(cb => cb.addEventListener("change", calculateTotals));
        });
    </script>
}