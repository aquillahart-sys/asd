@model EnrollmentSystem_G4.Models.EnrollmentAssessmentViewModel

@{
    ViewData["Title"] = "Enrollment Assessment";
}

<h1 class="h3">Enrollment Assessment</h1>
<p class="text-muted mb-1">
    @Model.Student.FullName (@Model.Student.StudentNumber) · @Model.Enrollment.AcademicYear · @Model.Enrollment.Semester
</p>
<p>Status: <span class="badge bg-secondary">@Model.Enrollment.Status</span></p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Subject</th><th>Section</th><th>Schedule</th><th>Units</th></tr></thead>
        <tbody>
            @foreach (var offering in Model.Offerings)
            {
                <tr>
                    <td>@offering.SubjectCode - @offering.SubjectDescription</td>
                    <td>@offering.Section</td>
                    <td>@offering.Schedule</td>
                    <td>@offering.Units</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Total units</th><th>@Model.TotalUnits</th></tr></tfoot>
    </table>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><span class="text-muted">Rate / unit</span><div class="fw-bold">₱@Model.RatePerUnit.ToString("N2")</div></div>
            <div class="col-md-3"><span class="text-muted">Tuition fee</span><div class="fw-bold">₱@Model.TuitionFee.ToString("N2")</div></div>
            <div class="col-md-3"><span class="text-muted">Miscellaneous</span><div class="fw-bold">₱@Model.MiscellaneousFee.ToString("N2")</div></div>
            <div class="col-md-3"><span class="text-muted">Other fees</span><div class="fw-bold">₱@Model.OtherFees.ToString("N2")</div></div>
            <div class="col-md-3"><span class="text-muted">Assessment</span><div class="fw-bold">₱@Model.TotalAssessment.ToString("N2")</div></div>
            <div class="col-md-3"><span class="text-muted">Required downpayment</span><div class="fw-bold">₱@Model.RequiredDownpayment.ToString("N2")</div></div>
            <div class="col-md-3"><span class="text-muted">Paid / balance</span><div class="fw-bold">₱@Model.TotalPaid.ToString("N2") / ₱@Model.RemainingBalance.ToString("N2")</div></div>
        </div>
    </div>
</div>

@if (Model.Enrollment.Status == "PENDING")
{
    @if (User.IsInRole("Administrator") || User.IsInRole("Registrar"))
    {
        <form asp-action="SaveAssessment" method="post" class="d-inline">
            <input type="hidden" name="enrollmentId" value="@Model.Enrollment.EnrollmentId" />
            <button type="submit" class="btn btn-primary">Save assessment</button>
        </form>
    }
    else
    {
        <span class="text-muted">This enrollment is awaiting assessment by a Registrar or Administrator.</span>
    }
}
else if (Model.Enrollment.Status == "ASSESSED")
{
    <div class="d-flex gap-2 flex-wrap">
        @if (User.IsInRole("Administrator") || User.IsInRole("Cashier"))
        {
            <a asp-controller="Payment" asp-action="Create" asp-route-enrollmentId="@Model.Enrollment.EnrollmentId" class="btn btn-outline-primary">Record payment</a>
        }
        @if (Model.CanConfirm && (User.IsInRole("Administrator") || User.IsInRole("Registrar")))
        {
            <form asp-action="Confirm" method="post">
                <input type="hidden" name="enrollmentId" value="@Model.Enrollment.EnrollmentId" />
                <button type="submit" class="btn btn-success">Confirm enrollment and create schedule</button>
            </form>
        }
        else if (!Model.CanConfirm)
        {
            <span class="text-muted align-self-center">Record the required downpayment before confirmation.</span>
        }
        else
        {
            <span class="text-muted align-self-center">Downpayment satisfied; awaiting Administrator or Registrar confirmation.</span>
        }
    </div>
}
else if (Model.Enrollment.Status == "CONFIRMED")
{
    <a asp-controller="Payment" asp-action="GenerateReport" asp-route-type="COR" asp-route-enrollmentId="@Model.Enrollment.EnrollmentId" class="btn btn-success">View Certificate of Registration</a>
    @if (User.IsInRole("Administrator") || User.IsInRole("Cashier"))
    {
        <a asp-controller="Payment" asp-action="Create" asp-route-enrollmentId="@Model.Enrollment.EnrollmentId" class="btn btn-outline-primary ms-2">Record monthly payment</a>
    }
}
<a asp-action="Index" class="btn btn-secondary ms-2">Back to enrollments</a>
