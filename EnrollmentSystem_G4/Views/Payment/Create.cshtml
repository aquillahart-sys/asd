@model EnrollmentSystem_G4.Models.Payment

@{
    ViewData["Title"] = "Record Payment";
}

<div class="container-fluid py-3 px-0 payment-form">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 form-heading mb-1">Record Payment</h1>
            <p class="text-muted">Payments are saved as individual transactions; account balances are recalculated from payment history.</p>
            <div class="card payment-entry-card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="EnrollmentId" class="form-label">Assessed or confirmed enrollment</label>
                        <select asp-for="EnrollmentId" id="enrollmentSelect" class="form-select" required>
                            <option value="0">Select an enrollment</option>
                            @if (ViewBag.Enrollments != null)
                            {
                                foreach (var enrollment in ViewBag.Enrollments)
                                {
                                    <option value="@enrollment.EnrollmentId"
                                            data-status="@enrollment.Status"
                                            data-assessment="@enrollment.TotalAssessment"
                                            data-paid="@enrollment.AmountPaid"
                                            data-balance="@enrollment.Balance"
                                            data-downpayment="@enrollment.RequiredDownpayment"
                                            selected="@(enrollment.EnrollmentId == Model.EnrollmentId)">
                                        @enrollment.DisplayName
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="EnrollmentId" class="text-danger"></span>
                    </div>

                    <div class="card summary-card border-0 mb-3">
                        <div class="card-body d-flex flex-wrap justify-content-between gap-3">
                            <div><span class="small text-muted">Assessment</span><div id="assessmentValue" class="summary-value fw-bold">₱0.00</div></div>
                            <div><span class="small text-muted">Total paid</span><div id="paidValue" class="summary-value fw-bold text-success">₱0.00</div></div>
                            <div><span class="small text-muted">Balance</span><div id="balanceValue" class="summary-value fw-bold text-danger">₱0.00</div></div>
                            <div><span class="small text-muted">Required downpayment</span><div id="downpaymentValue" class="summary-value fw-bold">₱0.00</div></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FeeType" class="form-label">Payment type</label>
                            <select asp-for="FeeType" id="paymentType" class="form-select">
                                <option value="Downpayment">Downpayment</option>
                                <option value="Monthly Payment">Monthly Payment</option>
                            </select>
                            <span asp-validation-for="FeeType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ScheduleId" class="form-label">Monthly installment</label>
                            <select asp-for="ScheduleId" id="scheduleSelect" class="form-select">
                                <option value="">Select an installment</option>
                                @if (ViewBag.Schedules != null)
                                {
                                    foreach (var schedule in ViewBag.Schedules)
                                    {
                                        <option value="@schedule.ScheduleId">
                                            @schedule.DueDate.ToString("MMM d, yyyy") · ₱@((schedule.ExpectedAmount - schedule.AmountPaid).ToString("N2")) remaining (@schedule.Status)
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ScheduleId" class="text-danger"></span>
                            <div class="form-text">Required for monthly payments; leave blank for a downpayment.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReceiptNumber" class="form-label">Receipt / reference number</label>
                            <input asp-for="ReceiptNumber" class="form-control" maxlength="50" autocomplete="off" required />
                            <span asp-validation-for="ReceiptNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentDate" class="form-label">Payment date</label>
                            <input asp-for="PaymentDate" type="date" class="form-control" required />
                            <span asp-validation-for="PaymentDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AmountPaid" class="form-label">Amount (₱)</label>
                            <input asp-for="AmountPaid" type="number" min="0.01" step="0.01" class="form-control" required />
                            <span asp-validation-for="AmountPaid" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option>Cash</option>
                                <option>GCash</option>
                                <option>Bank Transfer</option>
                                <option>Check</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save payment</button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const enrollmentSelect = document.getElementById("enrollmentSelect");
        const scheduleSelect = document.getElementById("scheduleSelect");
        const paymentType = document.getElementById("paymentType");

        function updatePaymentForm() {
            const option = enrollmentSelect.options[enrollmentSelect.selectedIndex];
            const status = option.dataset.status || "";
            const currency = value => "₱" + Number(value || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            document.getElementById("assessmentValue").textContent = currency(option.dataset.assessment);
            document.getElementById("paidValue").textContent = currency(option.dataset.paid);
            document.getElementById("balanceValue").textContent = currency(option.dataset.balance);
            document.getElementById("downpaymentValue").textContent = currency(option.dataset.downpayment);

            paymentType.value = status === "ASSESSED" ? "Downpayment" : "Monthly Payment";
            paymentType.disabled = status === "";
            scheduleSelect.disabled = status !== "CONFIRMED";
            if (status !== "CONFIRMED") {
                scheduleSelect.value = "";
            }
        }

        enrollmentSelect.addEventListener("change", updatePaymentForm);
        updatePaymentForm();
    </script>
}
