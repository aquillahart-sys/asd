@model EnrollmentSystem_G4.Models.Payment

@{
    ViewData["Title"] = "Cashier Payments";
}

<div class="container-fluid py-3 px-4" style="background-color: #f8fafc; min-height: 100vh;">

    <!-- Top Navigation Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="fw-bold mb-0" style="color: #0f172a;">Cashier Payments</h3>

        <div class="d-flex align-items-center gap-3">
            <div class="text-end me-1">
                <div class="fw-semibold text-muted small">@DateTime.Now.ToString("ddd, MMM d, yyyy")</div>
                <div class="text-muted" style="font-size: 0.75rem;">Academic Year 2026-2027</div>
            </div>
        </div>
    </div>

    <!-- Center Card Section -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="mb-4">
                <h4 class="fw-bold mb-1" style="color: #0f172a;">Process Student Payment Transaction</h4>
                <p class="text-muted small">Record tuition fees, issue official receipts, and update student fee balances.</p>
            </div>

            <!-- Main Form Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- SELECT STUDENT -->
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small text-uppercase" style="letter-spacing: 0.5px;">SELECT STUDENT</label>
                        <select id="studentSelect" asp-for="EnrollmentId" class="form-select form-select-lg rounded-3 fs-6 border-secondary-subtle" required onchange="updateSummaryMetrics()">
                            <option value="" data-assessment="0" data-paid="0" data-balance="0">-- Select Student --</option>
                            @if (ViewBag.Students != null)
                            {
                                foreach (var student in ViewBag.Students)
                                {
                                    <option value="@student.EnrollmentId"
                                            data-assessment="@student.TotalAssessment"
                                            data-paid="@student.AmountPaid"
                                            data-balance="@student.Balance">
                                        @student.DisplayName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- FINANCIAL SUMMARY CONTAINER -->
                    <div class="card border-0 rounded-4 p-3 mb-4" style="background-color: #f8fafc;">
                        <div class="row text-center align-items-center">
                            <div class="col-4 border-end">
                                <span class="text-muted fw-semibold small text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">TOTAL ASSESSMENT</span>
                                <div id="lblAssessment" class="fw-bold fs-5 mt-1" style="color: #0f172a;">₱0</div>
                            </div>
                            <div class="col-4 border-end">
                                <span class="text-muted fw-semibold small text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">AMOUNT PAID</span>
                                <div id="lblPaid" class="fw-bold fs-5 mt-1 text-success">₱0</div>
                            </div>
                            <div class="col-4">
                                <span class="text-muted fw-semibold small text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">CURRENT BALANCE</span>
                                <div id="lblBalance" class="fw-bold fs-5 mt-1 text-danger">₱0</div>
                            </div>
                        </div>
                    </div>

                    <!-- PAYMENT AMOUNT & PAYMENT CATEGORY -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted fw-bold small text-uppercase" style="letter-spacing: 0.5px;">PAYMENT AMOUNT (₱)</label>
                            <input id="txtAmount" asp-for="AmountPaid" type="number" step="0.01" class="form-control form-control-lg rounded-3 fs-6 border-secondary-subtle" placeholder="0" required />
                            <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted fw-bold small text-uppercase" style="letter-spacing: 0.5px;">PAYMENT CATEGORY</label>
                            <select asp-for="FeeType" class="form-select form-select-lg rounded-3 fs-6 border-secondary-subtle">
                                <option value="Full Tuition Fee">Full Tuition Fee</option>
                                <option value="Downpayment">Downpayment</option>
                                <option value="Partial Tuition">Partial Tuition</option>
                                <option value="Miscellaneous Fee">Miscellaneous Fee</option>
                            </select>
                        </div>
                    </div>

                    <!-- PAYMENT METHOD -->
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small text-uppercase" style="letter-spacing: 0.5px;">PAYMENT METHOD</label>
                        <select asp-for="PaymentMethod" class="form-select form-select-lg rounded-3 fs-6 border-secondary-subtle" required>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Check">Check</option>
                        </select>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-success btn-lg fw-bold px-4 py-3 rounded-3 shadow-sm d-flex align-items-center gap-2" style="background-color: #059669; border: none;">
                             Process Transaction
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateSummaryMetrics() {
            var select = document.getElementById("studentSelect");
            var selectedOption = select.options[select.selectedIndex];

            var assessment = parseFloat(selectedOption.getAttribute("data-assessment") || 0);
            var paid = parseFloat(selectedOption.getAttribute("data-paid") || 0);
            var balance = parseFloat(selectedOption.getAttribute("data-balance") || 0);

            document.getElementById("lblAssessment").innerText = "₱" + assessment.toLocaleString('en-US');
            document.getElementById("lblPaid").innerText = "₱" + paid.toLocaleString('en-US');
            document.getElementById("lblBalance").innerText = "₱" + balance.toLocaleString('en-US');

            // Auto-populate payment amount with remaining balance if selected
            if (balance > 0) {
                document.getElementById("txtAmount").value = balance;
            }
        }

        // Trigger on load if student pre-selected
        document.addEventListener("DOMContentLoaded", function () {
            updateSummaryMetrics();
        });
    </script>
}