@model IEnumerable<EnrollmentSystem_G4.Models.Payment>

@{
    ViewData["Title"] = "Balance dashboard";
}

<div class="container-fluid py-4 px-0 payment-dashboard">
    <section class="card payment-banner border-0 shadow-sm text-white mb-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <p class="eyebrow mb-2">FINANCIAL SERVICES</p>
                <h1 class="h2 fw-bold mb-1">Cashier Financial Portal</h1>
                <p class="text-light text-opacity-75 mb-0">Review receipts, student balances, and installment activity.</p>
            </div>
            @if (User.IsInRole("Administrator") || User.IsInRole("Cashier"))
            {
                <a asp-controller="Payment" asp-action="Create" class="btn fw-bold px-4 py-2 rounded-3">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Record payment
                </a>
            }
        </div>
    </section>

    <section class="row g-3 mb-4" aria-label="Payment overview">
        <div class="col-12 col-md-6 col-xxl-3">
            <article class="card metric-card border-0 shadow-sm rounded-4 p-3">
                <span class="text-muted small fw-semibold text-uppercase">Total collections</span>
                <h2 class="fw-bold mt-2 mb-1">₱@string.Format("{0:N2}", ViewBag.TotalCollections ?? 0)</h2>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-medium align-self-start">
                    Recorded in system
                </span>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xxl-3">
            <article class="card metric-card border-0 shadow-sm rounded-4 p-3">
                <span class="text-muted small fw-semibold text-uppercase">Outstanding balances</span>
                <h2 class="fw-bold mt-2 mb-1">₱@string.Format("{0:N2}", ViewBag.OutstandingBalances ?? 0)</h2>
                <span class="text-danger small fw-medium">Collectable tuition fees</span>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xxl-3">
            <article class="card metric-card border-0 shadow-sm rounded-4 p-3">
                <span class="text-muted small fw-semibold text-uppercase">Issued receipts</span>
                <h2 class="fw-bold mt-2 mb-1">@(ViewBag.IssuedReceiptsCount ?? 0)</h2>
                <span class="text-muted small">Official transactions issued</span>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xxl-3">
            <article class="card metric-card border-0 shadow-sm rounded-4 p-3">
                <span class="text-muted small fw-semibold text-uppercase">Overdue installments</span>
                <h2 class="fw-bold mt-2 mb-1 text-danger">@(ViewBag.OverdueInstallments ?? 0)</h2>
                <span class="text-muted small">Past due with a balance remaining</span>
            </article>
        </div>
    </section>

    <section class="card recent-payments-card border-0 shadow-sm rounded-4 p-3 p-md-4">
        <h2 class="h5 fw-bold mb-3">Recent payment transactions</h2>
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th scope="col">Receipt</th>
                        <th scope="col">Student</th>
                        <th scope="col">Payment type</th>
                        <th scope="col">Amount paid</th>
                        <th scope="col">Date</th>
                        <th scope="col" class="text-center">Reports</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No payment transactions recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.ReceiptNumber</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.StudentName</span>
                                    <span class="text-muted small">(@item.StudentNumber)</span>
                                </td>
                                <td>@item.FeeType</td>
                                <td class="fw-bold text-success">₱@string.Format("{0:N2}", item.AmountPaid)</td>
                                <td class="text-muted small">@item.PaymentDate.ToString("MMM d, yyyy, h:mm tt")</td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill fw-semibold px-3 dropdown-toggle"
                                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            View reports
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            @if (item.EnrollmentStatus == "CONFIRMED")
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-action="GenerateReport" asp-route-type="COR" asp-route-enrollmentId="@item.EnrollmentId">
                                                        Certificate of Registration
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <a class="dropdown-item" asp-action="GenerateReport" asp-route-type="Balance" asp-route-enrollmentId="@item.EnrollmentId">
                                                    Statement of account
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="GenerateReport" asp-route-type="History" asp-route-enrollmentId="@item.EnrollmentId">
                                                    Payment history
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
