@model IEnumerable<EnrollmentSystem_G4.Models.Payment>

@{
    ViewData["Title"] = "Cashier Financial Portal";
}

<div class="container-fluid py-4 px-4" style="background-color: #f8fafc; min-height: 100vh;">

    <!-- Top Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 text-white mb-4" style="background-color: #042e22;">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Cashier Financial Portal</h2>
                <p class="text-light text-opacity-75 mb-0">Manage student tuition billing, receipt generation, and fee balance directory.</p>
            </div>
            <a asp-controller="Payment" asp-action="Create" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm">
                + New Payment Transaction
            </a>
        </div>
    </div>

    <!-- Metrics Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">TOTAL COLLECTIONS</span>
                <h2 class="fw-bold mt-2 mb-1" style="color: #0f172a;">₱@string.Format("{0:N2}", ViewBag.TotalCollections ?? 0)</h2>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-medium" style="width: fit-content;">
                    ✓ Recorded in System
                </span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">OUTSTANDING BALANCES</span>
                <h2 class="fw-bold mt-2 mb-1" style="color: #0f172a;">₱@string.Format("{0:N2}", ViewBag.OutstandingBalances ?? 0)</h2>
                <span class="text-danger small fw-medium">Collectable Tuition Fees</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">ISSUED RECEIPTS</span>
                <h2 class="fw-bold mt-2 mb-1" style="color: #0f172a;">@(ViewBag.IssuedReceiptsCount ?? 0) Receipts</h2>
                <span class="text-muted small">Official Transactions Issued</span>
            </div>
        </div>
    </div>


    <!-- Recent Payments Table with Report Generators Integrated -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <h5 class="fw-bold mb-3" style="color: #1e293b;">Recent Payment Transactions</h5>

        <div class="table-responsive">
            <table class="table align-middle table-hover border-0 mb-0">
                <thead class="table-light text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">OR Number</th>
                        <th class="py-3">Student Name</th>
                        <th class="py-3">Fee Type</th>
                        <th class="py-3">Amount Paid</th>
                        <th class="py-3">Date</th>
                        <th class="py-3 text-center">Generate Report</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No payment transactions recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.ReceiptNumber</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.StudentName</span>
                                    <span class="text-muted small">(@item.StudentNumber)</span>
                                </td>
                                <td class="text-secondary">@item.FeeType</td>
                                <td class="fw-bold text-success">₱@string.Format("{0:N2}", item.AmountPaid)</td>
                                <td class="text-muted small">@item.PaymentDate.ToString("MMM d, yyyy, h:mm tt")</td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border rounded-pill fw-semibold px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            📄 Action
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li>
                                                <a class="dropdown-item small fw-semibold" asp-controller="Payment" asp-action="GenerateReport" asp-route-type="COR" asp-route-enrollmentId="@item.EnrollmentId">
                                                    📜 CorReportGenerator (COR)
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item small fw-semibold" asp-controller="Payment" asp-action="GenerateReport" asp-route-type="Balance" asp-route-enrollmentId="@item.EnrollmentId">
                                                    💳 BalanceReportGenerator
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>