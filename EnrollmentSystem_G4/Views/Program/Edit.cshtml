@model EnrollmentSystem_G4.Models.ProgramModel

@{
    ViewData["Title"] = "Edit Program";
}

<div class="page-header">
    <p class="eyebrow">ACADEMICS</p>
    <h1 class="h2 mb-1">Edit program</h1>
    <p class="text-muted mb-0">Changes are recorded in the Administrator audit history.</p>
</div>

<div class="card app-card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.ProgramId" method="post">
            <input asp-for="ProgramId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ProgramCode" class="form-label"></label>
                    <input asp-for="ProgramCode" class="form-control" />
                    <span asp-validation-for="ProgramCode" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="ProgramName" class="form-label"></label>
                    <input asp-for="ProgramName" class="form-control" />
                    <span asp-validation-for="ProgramName" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"><option>Active</option><option>Inactive</option></select>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
