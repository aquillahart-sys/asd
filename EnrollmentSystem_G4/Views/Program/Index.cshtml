@model IEnumerable<EnrollmentSystem_G4.Models.ProgramModel>

@{
    ViewData["Title"] = "Programs";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <p class="eyebrow">ACADEMICS</p>
        <h1 class="h2 mb-1">Programs</h1>
        <p class="text-muted mb-0">Manage the academic programs available for enrollment.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add program</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

<div class="card app-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Code</th><th>Program</th><th>Description</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var program in Model)
                {
                    <tr>
                        <td><strong>@program.ProgramCode</strong></td>
                        <td>@program.ProgramName</td>
                        <td>@program.Description</td>
                        <td><span class="badge text-bg-secondary">@program.Status</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@program.ProgramId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@program.ProgramId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this program? Linked records will prevent deletion.');">
                                    <i class="bi bi-trash" aria-hidden="true"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No programs have been added.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
