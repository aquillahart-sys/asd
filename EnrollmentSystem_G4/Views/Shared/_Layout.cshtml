@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var canManageAcademics = User.IsInRole("Administrator") || User.IsInRole("Registrar");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnrollmentSystem_G4</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnrollmentSystem_G4.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="sidebarBrand">
            <div class="sidebar-heading">
                <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index" id="sidebarBrand">
                    <span class="sidebar-brand-mark" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                    <span><strong>Enrollment</strong><small>STUDENT SERVICES</small></span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" aria-label="Close navigation"></button>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <span class="sidebar-section-label">CAMPUS</span>
                <a class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i><span>Overview</span>
                </a>
                @if (isAuthenticated)
                {
                    @if (canManageAcademics)
                    {
                        <a class="sidebar-link @(currentController == "Program" ? "active" : "")"
                           asp-controller="Program" asp-action="Index">
                            <i class="bi bi-journals" aria-hidden="true"></i><span>Programs</span>
                        </a>
                    }
                    <a class="sidebar-link @(currentController == "Student" ? "active" : "")"
                       asp-controller="Student" asp-action="Index">
                        <i class="bi bi-people-fill" aria-hidden="true"></i><span>Students</span>
                    </a>
                    @if (canManageAcademics)
                    {
                        <a class="sidebar-link @(currentController == "Subject" ? "active" : "")"
                           asp-controller="Subject" asp-action="Index">
                            <i class="bi bi-book-half" aria-hidden="true"></i><span>Subjects</span>
                        </a>
                        <a class="sidebar-link @(currentController == "SubjectOffering" ? "active" : "")"
                           asp-controller="SubjectOffering" asp-action="Index">
                            <i class="bi bi-calendar2-week" aria-hidden="true"></i><span>Offerings</span>
                        </a>
                    }
                    <a class="sidebar-link @(currentController == "Enrollment" ? "active" : "")"
                       asp-controller="Enrollment" asp-action="Index">
                        <i class="bi bi-card-checklist" aria-hidden="true"></i><span>Enrollments</span>
                    </a>

                    <span class="sidebar-section-label sidebar-section-spaced">FINANCE</span>
                    <a class="sidebar-link @(currentController == "Payment" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Payment" asp-action="Index">
                        <i class="bi bi-receipt" aria-hidden="true"></i><span>Balance dashboard</span>
                    </a>
                    @if (User.IsInRole("Administrator") || User.IsInRole("Cashier"))
                    {
                        <a class="sidebar-link @(currentController == "Payment" && currentAction == "Create" ? "active" : "")"
                           asp-controller="Payment" asp-action="Create">
                            <i class="bi bi-cash-coin" aria-hidden="true"></i><span>Record payment</span>
                        </a>
                    }

                    @if (User.IsInRole("Administrator"))
                    {
                        <span class="sidebar-section-label sidebar-section-spaced">ADMINISTRATION</span>
                        <a class="sidebar-link @(currentController == "User" ? "active" : "")"
                           asp-controller="User" asp-action="Index">
                            <i class="bi bi-person-gear" aria-hidden="true"></i><span>User accounts</span>
                        </a>
                        <a class="sidebar-link @(currentController == "Audit" ? "active" : "")"
                           asp-controller="Audit" asp-action="Index">
                            <i class="bi bi-shield-check" aria-hidden="true"></i><span>Audit log</span>
                        </a>
                    }
                }
                else
                {
                    <p class="sidebar-section-label">Sign in to access campus services.</p>
                }
            </nav>

            <div class="sidebar-footer">
                <span class="status-dot" aria-hidden="true"></span>
                <span><strong>Enrollment portal</strong><small>Campus services</small></span>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-heading">
                    <button class="btn sidebar-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <span class="topbar-kicker">CAMPUS PORTAL</span>
                </div>
                @if (isAuthenticated)
                {
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small">@User.Identity?.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-signout" type="submit">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Sign out
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn btn-signout" asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </header>

            <main role="main" class="page-shell">
                @RenderBody()
            </main>

            <footer class="site-footer">
                <span>&copy; @DateTime.Now.Year Enrollment Services</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
