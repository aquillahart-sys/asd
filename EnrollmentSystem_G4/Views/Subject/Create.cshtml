@model EnrollmentSystem_G4.Models.Subject

@{
    ViewData["Title"] = "Add Subject";
}

<div class="page-header">
    <p class="eyebrow">ACADEMICS</p>
    <h1 class="h2 mb-1">Add subject</h1>
    <p class="text-muted mb-0">Add a subject to the catalog.</p>
</div>

<div class="card app-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="SubjectCode" class="form-label"></label>
                <input asp-for="SubjectCode" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="SubjectDescription" class="form-label"></label>
                <input asp-for="SubjectDescription" class="form-control" />
            </div>
            <div class="mb-4">
                <label asp-for="Units" class="form-label"></label>
                <input asp-for="Units" class="form-control" type="number" min="1" />
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create subject</button>
            </div>
        </form>
    </div>
</div>
